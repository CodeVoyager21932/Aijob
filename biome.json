{
  "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.claude",
      "!**/.data",
      "!vendor/reactive-resume",
      "!vendor/reactive-resume-v6",
      "!**/.hatch-runs",
      "!docs/reviews/resume-system-research-2026-09-10/code",
      "!docs/evidence/resume-studio-quality-2026-09-10/upstream"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
