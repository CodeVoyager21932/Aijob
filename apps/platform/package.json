{
  "name": "@aijob/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "db:migrate": "tsx src/migrate.ts",
    "dev": "tsx watch src/dev.ts",
    "dev:collector-worker": "tsx watch src/collector-worker.ts",
    "dev:web-api": "tsx watch src/server.ts",
    "dev:match-worker": "tsx watch src/match-worker.ts",
    "start": "node dist/server.js",
    "start:collector-worker": "node dist/collector-worker.js",
    "start:match-worker": "node dist/match-worker.js",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aijob/config": "workspace:*",
    "@aijob/contracts": "workspace:*",
    "@aijob/database": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "cheerio": "1.2.0",
    "commander": "14.0.0",
    "csv-parse": "6.1.0",
    "docx": "^9.7.1",
    "fastify": "5.12.1",
    "kysely": "0.28.17",
    "mammoth": "^1.12.0",
    "nodemailer": "10.0.0",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "1.63.0",
    "yauzl": "^3.4.0",
    "zod": "3.25.76",
    "@aijob/resume-core": "workspace:*",
    "@aijob/resume-renderer": "workspace:*"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "@types/yauzl": "^3.4.0",
    "tsx": "4.20.3",
    "vitest": "3.2.6"
  }
}
