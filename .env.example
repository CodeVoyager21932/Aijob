# Local development defaults. Copy to .env only when you need to override them.
APP_ENV=local
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_URL=postgresql://aijob:aijob@127.0.0.1:5432/aijob
ENABLE_INTERNAL_PREVIEW=true
ENABLE_SOURCE_PROBE=true
ENABLE_LOCAL_MVP=true
SNAPSHOT_DIR=.data/job-snapshots
PROBE_REQUEST_INTERVAL_MS=750
# Local/test startup creates and reuses .data/resume-encryption.key when this is unset.
# Set an explicit random 64-character hex key for isolated tests. Alpha and production
# require this environment variable and never use the workspace-local key file.
# RESUME_ENCRYPTION_KEY=
RESUME_MAX_BYTES=5242880
# Local/test can retain the child-process parser. Alpha and production require
# an immutable, purpose-built image and run it without network, mounts or privileges.
# RESUME_PARSER_MODE=container
# RESUME_PARSER_CONTAINER_IMAGE=registry.example/aijob/resume-parser@sha256:<64-hex-digest>
# Local MVP development can use `pnpm ai:configure`, which writes a Git-ignored
# backend-only file under `.data/`. Environment variables remain an alternative
# configuration source for a later deployment.
# ENABLE_AI=true
# AI_BASE_URL=https://api.example.com/v1
# AI_MODEL=
# AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=30000

# Private Alpha only: configure the exact HTTPS web origin, a backend-only
# 64-character hex master key, and keyed SHA-256 hashes of invited normalized emails.
# Never commit email addresses, keys, verification codes or their hashes to Git.
# ACCEPTED_ORIGINS=https://alpha.example.com
# IDENTITY_MASTER_KEY=
# ALPHA_INVITED_EMAIL_HASHES=
# Real email delivery remains disabled until a separately approved provider is wired.
IDENTITY_EMAIL_DELIVERY_MODE=disabled
# Test-only fixture delivery is rejected by Alpha/production config validation.
# IDENTITY_FIXTURE_VERIFICATION_CODE=

# Alpha/production processes require separate PostgreSQL login URLs. Each login
# must be a member of the corresponding NOLOGIN role created by migration 021.
# WEB_API_DATABASE_URL=
# COLLECTOR_DATABASE_URL=
# MATCH_DATABASE_URL=
# OPS_DATABASE_URL=
# MIGRATOR_DATABASE_URL=
