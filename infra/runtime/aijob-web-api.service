[Unit]
Description=Aijob web API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aijob-web
Group=aijob-web
WorkingDirectory=/opt/aijob
EnvironmentFile=/etc/aijob/web-api.env
ExecStart=/usr/local/bin/pnpm --filter @aijob/platform exec tsx dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/aijob/.data /run/user
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
