# Template only. Split values into web-api, match-worker, collector and migrator files.
# Never give the collector personal encryption, SMTP or personal-AI credentials.
APP_ENV=alpha
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
ENABLE_INTERNAL_PREVIEW=false
ENABLE_LOCAL_MVP=false
ENABLE_SOURCE_PROBE=false
COLLECTOR_AUTOMATION_ENABLED=false
# Supply runtime-specific login URLs. Each login is a member of only its existing role.
DATABASE_URL=
WEB_API_DATABASE_URL=
MATCH_DATABASE_URL=
COLLECTOR_DATABASE_URL=
OPS_DATABASE_URL=
MIGRATOR_DATABASE_URL=
RESUME_ENCRYPTION_KEY=
IDENTITY_MASTER_KEY=
ACCEPTED_ORIGINS=https://replace-with-your-domain.example
IDENTITY_EMAIL_DELIVERY_MODE=disabled
# Switch to smtp after the real delivery check. No fixture codes in remote environments.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESUME_PARSER_MODE=container
RESUME_PARSER_CONTAINER_IMAGE=
RESUME_REVIEW_V2_WRITE_ENABLED=true
PDF_BROWSER_EXECUTABLE=/usr/bin/chromium
PDF_FONT_PATH=/opt/fonts/AijobCJK.otf
PDF_SERIF_FONT_PATH=/opt/fonts/AijobSerifCJK.otf
PDF_RENDER_CONCURRENCY=2
PDF_RENDER_TIMEOUT_MS=30000
ENABLE_AI=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
PERSONAL_AI_DAILY_CALLS=0
PERSONAL_AI_DAILY_TOKEN_BUDGET=0
PERSONAL_AI_CONCURRENCY=2
PERSONAL_AI_MAX_OUTPUT_TOKENS=2048
PUBLIC_AI_DAILY_CALLS=0
PUBLIC_AI_DAILY_TOKEN_BUDGET=0
PUBLIC_AI_CONCURRENCY=1
PUBLIC_AI_MAX_OUTPUT_TOKENS=2048

# Per match-worker process; owner API budgets/concurrency remain separate.
OWNER_TASK_INTERACTIVE_CONCURRENCY=8
